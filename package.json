{
  "name": "mandar.fm",
  "version": "0.1.0",
  "private": true,
  "description": "A Nagpuri/Sadri nostalgia radio for Jharkhand.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "verify": "tsx scripts/verify-playlists.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run verify && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
